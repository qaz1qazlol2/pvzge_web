/.vscode

# 构建产物（build.sh 的默认输出目录）
/dist/
# 按分支分别构建时的独立输出目录：dist-zbtonly / dist-master ...
/dist-*/
/tools/**/target/
/tools/**/gen/
/tools/**/bin/
/tools/**/obj/
/tools/**/publish/
/tools/**/build_incremental.log

# Python 缓存（tools/ 下的脚本互相 import 时生成，比如 verify_exe -> extract_icon）
__pycache__/
*.pyc
